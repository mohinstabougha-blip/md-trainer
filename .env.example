# --- KP Baden: Umgebungsvariablen ------------------------------------------
# Kopiere diese Datei nach .env.local (lokal) bzw. trage die Werte im Hosting-
# Provider (z.B. Vercel Project Settings -> Environment Variables) ein.

# Supabase (Projekt-URL + Keys aus dem Supabase-Dashboard: Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...           # "anon" public key
SUPABASE_SERVICE_ROLE_KEY=eyJ...               # "service_role" key – NUR serverseitig, niemals ins Frontend

# Admin-Bereich: Passwort für die Anmeldung unter /kp-team-anmeldung
ADMIN_PASSWORD=ein-langes-zufaelliges-passwort

# Cloudflare Turnstile (Bot-Schutz) – https://dash.cloudflare.com -> Turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAA...   # Site Key (öffentlich)
TURNSTILE_SECRET_KEY=0x4AAAAAAA...             # Secret Key – aktiviert die serverseitige Prüfung

# Öffentliche Basis-URL der Anwendung (für Metadaten/OpenGraph/Canonical)
NEXT_PUBLIC_SITE_URL=https://kpbaden.com

# Nur für die Import-Skripte in scripts/ (nicht für den Laufbetrieb nötig)
ANTHROPIC_API_KEY=sk-ant-...
